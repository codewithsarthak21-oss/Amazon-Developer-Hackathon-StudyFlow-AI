{
  "name": "studyflow-ai",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["frontend", "server"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "npm --workspace server run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build && npm --workspace server run build"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
